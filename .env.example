# Optional Kuaixue catalog API origin for local integration testing.
# Leave empty to use the clearly labeled demo catalog.
VITE_KUAIXUE_API_BASE_URL=

# Optional server-process settings supplied by the staging operator.
KUAIXUE_ACCOUNT_PROVIDER=
KUAIXUE_MAIN_SITE_ORIGIN=
# Server only: loopback origin for /internal/* when the public main-site origin is fronted by Nginx.
KUAIXUE_INTERNAL_ORIGIN=
# Public browser origin used for desktop authorization callbacks.
KUAIXUE_PUBLIC_MAIN_ORIGIN=
KUAIXUE_CLIENT_ID=
KUAIXUE_REDIRECT_URI=
# Server only: encrypts stored main-site tokens inside the course-service session database.
KUAIXUE_SESSION_SECRET=
# Server only: shared secret for the main site's loopback-only /internal/kuaixue routes.
# Never expose this value to the renderer, desktop package, or client configuration.
KUAIXUE_INTERNAL_SECRET=
# Transitional fallback accepted during integration when KUAIXUE_INTERNAL_SECRET is empty.
KUAIXUE_WALLET_SECRET=
# Server only: main-site canvas billing and RunningHub model execution credentials.
# These values must never be included in the desktop package.
KUAIXUE_CANVAS_BILLING_SECRET=
RUNNINGHUB_API_KEY=
RUNNINGHUB_AI_API_KEY=
# Server only: absolute directory for course assets returned to desktop clients.
KUAIXUE_ASSET_ROOT=
# Enable only with a configured course service and a separate HTTPS Vibe runtime origin.
VITE_KUAIXUE_COURSE_SERVICE=0
VITE_KUAIXUE_VIBE_ORIGIN=

VITE_KUAIXUE_AUTHORIZE_URL=
VITE_KUAIXUE_CLIENT_ID=
KUAIXUE_COURSE_DB=
# Server only: absolute path to the separate ticket database shared with the co-hosted runtime gateway.
KUAIXUE_RUNTIME_TICKET_DB=
KUAIXUE_BIND_HOST=127.0.0.1
KUAIXUE_API_PORT=4188
KUAIXUE_PURCHASES_ENABLED=0
# Trusted renderer origin for an integrated desktop build.
# KUAIXUE_ALLOWED_ORIGINS=kuaixue://classroom
